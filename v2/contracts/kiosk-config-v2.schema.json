{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.invalid/kiosk-config-v2.schema.json",
  "title": "Kiosk V2 configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorUser",
    "allowedApplication",
    "kiosk",
    "logging"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "operatorUser": {"type": "string", "minLength": 1},
    "allowedApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "arguments",
        "workingDirectory",
        "restartOnExit",
        "singleInstance",
        "bringToFront",
        "startMaximized",
        "restoreIfMinimized",
        "restartDelayMs",
        "maxRestartAttempts",
        "restartWindowSeconds"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "arguments": {"type": "string"},
        "workingDirectory": {"type": "string"},
        "restartOnExit": {"type": "boolean"},
        "singleInstance": {"type": "boolean"},
        "bringToFront": {"type": "boolean"},
        "startMaximized": {"type": "boolean"},
        "restoreIfMinimized": {"type": "boolean"},
        "restartDelayMs": {
          "type": "integer",
          "minimum": 250,
          "maximum": 60000
        },
        "maxRestartAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "restartWindowSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600
        }
      }
    },
    "kiosk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowWinL",
        "adminSessionTimeoutSeconds",
        "explorerGuardIntervalMs",
        "keyboardGuardRequired"
      ],
      "properties": {
        "allowWinL": {"const": true},
        "adminSessionTimeoutSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        },
        "explorerGuardIntervalMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 5000
        },
        "keyboardGuardRequired": {"const": true}
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logDirectory", "level", "maxBytes", "backupCount"],
      "properties": {
        "logDirectory": {"type": "string", "minLength": 1},
        "level": {"enum": ["Debug", "Info", "Warning", "Error"]},
        "maxBytes": {"type": "integer", "minimum": 65536},
        "backupCount": {"type": "integer", "minimum": 1, "maximum": 20}
      }
    }
  }
}
